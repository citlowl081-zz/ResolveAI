page { background: #f9fafb; font-size: 28rpx; color: #1f2937; }
.container { padding: 24rpx; }
.card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.btn { display: block; width: 100%; padding: 20rpx; border-radius: 12rpx; text-align: center; font-size: 30rpx; }
.btn-primary { background: #2563eb; color: #fff; }
.btn-danger { background: #ef4444; color: #fff; }
.btn-success { background: #16a34a; color: #fff; }
.btn-outline { background: #fff; color: #2563eb; border: 2rpx solid #2563eb; }
.input { width: 100%; padding: 20rpx; border: 2rpx solid #e5e7eb; border-radius: 12rpx; font-size: 28rpx; margin-bottom: 16rpx; box-sizing: border-box; }
.badge { display: inline-block; padding: 4rpx 16rpx; border-radius: 8rpx; font-size: 22rpx; }
.badge-blue { background: #dbeafe; color: #1d4ed8; }
.badge-green { background: #dcfce7; color: #16a34a; }
.badge-yellow { background: #fef9c3; color: #a16207; }
.badge-red { background: #fee2e2; color: #dc2626; }
.badge-gray { background: #f3f4f6; color: #6b7280; }
.flex-row { display: flex; flex-direction: row; align-items: center; }
.flex-between { display: flex; justify-content: space-between; align-items: center; }
.text-sm { font-size: 24rpx; }
.text-gray { color: #6b7280; }
.text-red { color: #dc2626; }
.text-green { color: #16a34a; }
.text-blue { color: #2563eb; }
.mt-2 { margin-top: 16rpx; }
.mb-2 { margin-bottom: 16rpx; }
.loading-text { text-align: center; padding: 80rpx 0; color: #9ca3af; }
.empty-text { text-align: center; padding: 100rpx 0; color: #9ca3af; font-size: 28rpx; }
.error-text { text-align: center; padding: 40rpx; color: #dc2626; }

/* Authentication pages */
.auth-page {
  min-height: 100vh;
  padding: 56rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}
.auth-page--compact { padding-top: 40rpx; }
.auth-shell { width: 100%; max-width: 680rpx; margin: 0 auto; }
.auth-brand { text-align: center; margin-bottom: 48rpx; }
.auth-page--compact .auth-brand { margin-bottom: 36rpx; }
.auth-brand__title {
  display: block;
  color: #1d4ed8;
  font-size: 56rpx;
  font-weight: 600;
  line-height: 1.2;
}
.auth-brand__subtitle {
  margin-top: 16rpx;
  color: #7b8494;
  font-size: 29rpx;
  line-height: 1.5;
}
.auth-form { width: 100%; }
.auth-field {
  display: flex;
  align-items: center;
  width: 100%;
  height: 92rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
  background: #ffffff;
  border: 1rpx solid #d9dee7;
  border-radius: 16rpx;
  box-sizing: border-box;
}
.auth-page--compact .auth-field { margin-bottom: 20rpx; }
.auth-field--focused {
  border-color: #2563eb;
  box-shadow: 0 0 0 2rpx rgba(37, 99, 235, 0.1);
}
.auth-input {
  display: block;
  width: 100%;
  height: 100%;
  padding: 0 30rpx;
  color: #1f2937;
  font-size: 32rpx;
  box-sizing: border-box;
}
.auth-placeholder { color: #8b95a5; font-size: 30rpx; }
.auth-error {
  margin: 0 0 20rpx;
  padding: 14rpx 18rpx;
  color: #c24141;
  background: #fff1f2;
  border-radius: 12rpx;
  font-size: 27rpx;
  line-height: 1.45;
  text-align: left;
}
button.auth-submit {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 92rpx;
  margin-top: 8rpx;
  padding: 0;
  color: #ffffff;
  background: #2563eb;
  border-radius: 16rpx;
  font-size: 33rpx;
  font-weight: 500;
  line-height: 1;
}
button.auth-submit::after { border: 0; }
button.auth-submit[disabled] { color: rgba(255, 255, 255, 0.8); background: #93b4f5; }
.auth-link {
  margin-top: 32rpx;
  color: #667085;
  font-size: 29rpx;
  line-height: 1.5;
  text-align: center;
}
.auth-link__action { display: inline; color: #2563eb; }
