<view class="container">
  <view class="page-heading">
    <view><view class="page-title">长期记忆</view><view class="page-subtitle">仅保存你主动确认的偏好与信息</view></view>
    <button bindtap="toggleForm" class="compact-button primary">{{showForm?'取消':'新建记忆'}}</button>
  </view>
  <view wx:if="{{showForm}}" class="card">
    <picker value="{{typeIdx}}" range="{{typeLabels}}" bindchange="onType"><view class="input">类型：{{typeLabels[typeIdx]}}</view></picker>
    <input class="input" placeholder="记忆标识（可选）" bindinput="onKey" value="{{memKey}}" />
    <textarea class="input textarea" placeholder="输入需要长期记住的内容" bindinput="onContent" value="{{memContent}}" />
    <button bindtap="create" class="btn btn-success">保存记忆</button>
  </view>
  <view wx:if="{{loading}}" class="loading-text">正在加载...</view>
  <view wx:elif="{{error}}" class="error-text">{{error}}</view>
  <view wx:elif="{{items.length===0}}" class="empty-text">暂无长期记忆</view>
  <view wx:for="{{items}}" wx:key="id" class="card">
    <view class="flex-row memory-meta">
      <text class="badge badge-blue">{{labelText[item.memory_type] || item.memory_type}}</text>
      <text wx:if="{{item.key}}" class="text-sm text-gray">{{item.key}}</text>
      <text class="text-sm text-gray">版本 {{item.version}}</text>
    </view>
    <block wx:if="{{editingId===item.id}}">
      <textarea class="input textarea" value="{{editingContent}}" bindinput="onEditingContent" />
      <view class="row-actions"><button class="compact-button primary" bindtap="update">保存修改</button><button class="compact-button" bindtap="cancelEdit">取消</button></view>
    </block>
    <block wx:else>
      <view>{{item.content}}</view>
      <view class="text-sm text-gray mt-2">来源：{{item.source==='explicit_agent_confirmation'?'对话中主动确认':'用户主动创建'}}</view>
      <view class="row-actions"><button class="compact-button" bindtap="edit" data-id="{{item.id}}">修改</button><button class="compact-button danger" bindtap="remove" data-id="{{item.id}}">删除</button></view>
    </block>
  </view>
</view>
