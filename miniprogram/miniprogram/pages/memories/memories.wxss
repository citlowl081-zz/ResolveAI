.page-heading { display: flex; align-items: center; justify-content: space-between; margin-bottom: 24rpx; }
.page-title { font-size: 36rpx; font-weight: 700; }
.page-subtitle { margin-top: 6rpx; color: #64748b; font-size: 22rpx; }
.compact-button { margin: 0; padding: 10rpx 18rpx; border: 1rpx solid #cbd5e1; border-radius: 9rpx; background: #fff; font-size: 23rpx; line-height: 1.5; }
.compact-button.primary { border-color: #2563eb; background: #2563eb; color: #fff; }
.compact-button.danger { border-color: #fecaca; color: #dc2626; }
.textarea { height: 130rpx; }
.memory-meta { gap: 12rpx; margin-bottom: 12rpx; }
.row-actions { display: flex; gap: 12rpx; margin-top: 18rpx; }
