<view class="products-page">
  <view class="products-title">精选商品</view>
  <scroll-view class="category-tabs" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="category-tab {{activeCategory===''?'active':''}}" data-category="" bindtap="chooseCategory">全部</view>
    <view wx:for="{{categories}}" wx:key="key" class="category-tab {{activeCategory===item.key?'active':''}}" data-category="{{item.key}}" bindtap="chooseCategory">{{item.label}}</view>
  </scroll-view>
  <view wx:if="{{query}}" class="filter-note">搜索“{{query}}” · {{items.length}} 件商品</view>
  <view wx:if="{{loading}}" class="loading-text">加载中...</view>
  <view wx:elif="{{error}}" class="error-text">{{error}}</view>
  <view wx:elif="{{items.length===0}}" class="empty-text">没有找到相关商品</view>
  <view wx:else class="product-grid">
    <navigator wx:for="{{items}}" wx:key="id" url="/pages/product-detail/product-detail?id={{item.id}}" class="product-card">
      <view class="product-placeholder">待上传商品图片</view>
      <view class="product-name">{{item.name}}</view>
      <view class="product-category">{{item.categoryLabel}} · 库存 {{item.stock}}</view>
      <view class="product-price">¥{{item.price}}</view>
    </navigator>
  </view>
</view>
