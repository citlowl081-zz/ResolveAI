.page-title { font-size: 36rpx; font-weight: 700; }
.page-subtitle { margin: 8rpx 0 24rpx; color: #64748b; font-size: 23rpx; }
.detail-link { margin-top: 14rpx; color: #2563eb; font-size: 23rpx; }
.modal-mask { position: fixed; z-index: 20; inset: 0; display: flex; align-items: flex-end; background: rgba(15, 23, 42, .45); }
.detail-panel { width: 100%; max-height: 76vh; box-sizing: border-box; padding: 28rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); overflow-y: auto; border-radius: 28rpx 28rpx 0 0; background: #fff; }
.detail-title { font-size: 34rpx; font-weight: 700; }
.close-button { margin: 0; padding: 8rpx 18rpx; background: #f1f5f9; color: #334155; font-size: 22rpx; line-height: 1.5; }
.detail-row { display: flex; justify-content: space-between; gap: 24rpx; padding: 18rpx 0; border-bottom: 1rpx solid #e2e8f0; font-size: 24rpx; }
.detail-row text:first-child { flex: none; color: #64748b; }
.detail-row text:last-child { min-width: 0; text-align: right; word-break: break-all; }
