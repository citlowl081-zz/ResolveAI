<view class="container">
  <block wx:if="{{loading}}"><view class="loading-text">加载中...</view></block>
  <block wx:elif="{{error}}"><view class="error-text">{{error}}</view></block>
  <block wx:elif="{{product}}">
    <view class="card product-detail-card">
      <view class="product-placeholder">待上传商品图片</view>
      <view class="product-title">{{product.name}}</view>
      <view class="product-price">¥{{product.price}}</view>
      <view class="product-facts">
        <view><text>分类</text><text>{{product.category}}</text></view>
        <view><text>SKU</text><text>当前接口暂未提供</text></view>
        <view><text>库存</text><text>{{product.stock}} 件</text></view>
      </view>
      <view class="detail-section">
        <view class="detail-heading">商品卖点</view>
        <view class="description">{{product.description || '商品详情持续完善中，请以实际商品信息为准。'}}</view>
      </view>
      <view class="detail-section after-sales-section">
        <view class="detail-heading">售后保障</view>
        <view>{{product.is_returnable ? '支持按已公示政策申请退换，具体以商品完好情况和适用规则为准。' : '不支持无理由退换；如存在质量问题，可咨询 AI 售后助手。'}}</view>
      </view>
      <view class="detail-actions">
        <button class="detail-button secondary" bindtap="askAgent">咨询 AI 售后</button>
        <button class="detail-button primary" bindtap="addToCart">加入购物车</button>
      </view>
    </view>
  </block>
</view>
