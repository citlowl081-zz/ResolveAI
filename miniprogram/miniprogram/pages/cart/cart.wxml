<view class="cart-page">
  <view wx:if="{{items.length===0}}" class="cart-empty">
    <view class="empty-mark">购</view>
    <view class="empty-title">购物车还是空的</view>
    <view class="empty-copy">去挑选适合你的智能数码与桌面好物</view>
    <navigator open-type="switchTab" url="/pages/index/index" class="empty-action">去逛逛</navigator>
  </view>

  <view wx:else class="cart-content">
    <view class="cart-list">
      <view wx:for="{{items}}" wx:key="product.id" class="cart-item">
        <view class="select-dot {{item.selected?'selected':''}}" data-id="{{item.product.id}}" bindtap="toggleItem">{{item.selected?'✓':''}}</view>
        <navigator url="/pages/product-detail/product-detail?id={{item.product.id}}" class="product-thumb">待上传商品图片</navigator>
        <view class="cart-info">
          <navigator url="/pages/product-detail/product-detail?id={{item.product.id}}" class="cart-name">{{item.product.name}}</navigator>
          <view class="cart-price">¥{{item.product.price}}</view>
          <view class="cart-actions">
            <view class="quantity-control">
              <button data-id="{{item.product.id}}" data-delta="-1" bindtap="changeQuantity">−</button>
              <text>{{item.quantity}}</text>
              <button data-id="{{item.product.id}}" data-delta="1" bindtap="changeQuantity">+</button>
            </view>
            <button class="remove-button" data-id="{{item.product.id}}" bindtap="removeItem">删除</button>
          </view>
        </view>
      </view>
    </view>
    <view class="checkout-note">当前演示版本暂未开放在线结算</view>
  </view>

  <view wx:if="{{items.length}}" class="cart-footer">
    <view class="select-all" bindtap="toggleAll"><view class="select-dot {{allSelected?'selected':''}}">{{allSelected?'✓':''}}</view><text>全选</text></view>
    <view class="cart-total"><text>合计</text><text class="total-price">¥{{total}}</text><view>已选 {{selectedCount}} 件</view></view>
    <button class="checkout-button" bindtap="showCheckoutBoundary">结算</button>
  </view>
</view>
