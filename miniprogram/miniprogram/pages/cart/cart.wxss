.cart-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx 276rpx; background: #f5f7fa; }
.cart-content { width: 100%; max-width: 920rpx; margin: 0 auto; }
.cart-list { display: flex; flex-direction: column; gap: 16rpx; }
.cart-item { display: flex; align-items: center; gap: 18rpx; padding: 22rpx; border: 1rpx solid #e5e7eb; border-radius: 18rpx; background: #fff; }
.select-dot { display: flex; flex: none; align-items: center; justify-content: center; width: 38rpx; height: 38rpx; border: 2rpx solid #cbd5e1; border-radius: 50%; color: #fff; font-size: 24rpx; }
.select-dot.selected { border-color: #2f6bee; background: #2f6bee; }
.product-thumb { display: flex; flex: none; align-items: center; justify-content: center; width: 132rpx; height: 132rpx; padding: 12rpx; border-radius: 14rpx; background: #eef2f7; color: #98a2b3; font-size: 22rpx; line-height: 1.35; text-align: center; box-sizing: border-box; }
.cart-info { min-width: 0; flex: 1; }
.cart-name { overflow: hidden; color: #1f2937; font-size: 29rpx; font-weight: 600; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.cart-price { margin-top: 10rpx; color: #2f6bee; font-size: 30rpx; font-weight: 700; }
.cart-actions { display: flex; align-items: center; justify-content: space-between; margin-top: 14rpx; }
.quantity-control { display: flex; align-items: center; gap: 18rpx; }
.quantity-control button, .remove-button { min-width: 48rpx; height: 48rpx; margin: 0; padding: 0; border: 1rpx solid #e5e7eb; border-radius: 10rpx; background: #fff; color: #475467; font-size: 26rpx; line-height: 46rpx; }
.quantity-control button::after, .remove-button::after, .checkout-button::after { border: 0; }
button.remove-button { width: auto; min-width: 60rpx; border: 0; color: #667085; font-size: 24rpx; }
.checkout-note { padding: 22rpx 0; color: #98a2b3; text-align: center; font-size: 24rpx; }
.cart-footer { position: fixed; right: 0; bottom: 100rpx; left: 0; display: flex; align-items: center; gap: 18rpx; padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e5e7eb; background: #fff; }
.select-all { display: flex; align-items: center; gap: 10rpx; color: #475467; font-size: 26rpx; }
.cart-total { min-width: 0; flex: 1; color: #667085; text-align: right; font-size: 22rpx; }
.total-price { margin-left: 8rpx; color: #1f2937; font-size: 30rpx; font-weight: 700; }
button.checkout-button { flex: none; width: 156rpx; min-width: 156rpx; height: 76rpx; margin: 0; padding: 0; border-radius: 14rpx; background: #2f6bee; color: #fff; font-size: 29rpx; line-height: 76rpx; }
.cart-empty { padding: 220rpx 30rpx 80rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 104rpx; height: 104rpx; margin: 0 auto 28rpx; border-radius: 28rpx; background: #eaf0ff; color: #2f6bee; font-size: 36rpx; font-weight: 700; }
.empty-title { font-size: 32rpx; font-weight: 700; }
.empty-copy { margin-top: 12rpx; color: #667085; font-size: 26rpx; }
.empty-action { width: 220rpx; margin: 34rpx auto 0; padding: 20rpx 0; border-radius: 14rpx; background: #2f6bee; color: #fff; font-size: 29rpx; }
